// Product Pipeline SOP & Task Manager — data model.
// Connection URLs live in prisma.config.ts (DIRECT_URL for the CLI) and in
// src/lib/server/db.ts (pooled DATABASE_URL for the app, via @prisma/adapter-pg).
// Money is always Decimal, never Float.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RESEARCHER
  IMAGE_DESIGNER
  VIDEO_EDITOR
  MEDIA_BUYER
  REVIEWER
  ADMIN
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum ProductStage {
  RESEARCH
  REVIEW
  CREATIVE
  READY_TO_LAUNCH
  LIVE
  COMPLETED
  KILLED
}

enum CampaignStatus {
  NOT_LAUNCHED
  RUNNING
  SCALING
  PAUSED
  STOPPED
}

enum TaskType {
  RESEARCH
  PRODUCT_APPROVAL
  WEBSITE_IMAGE
  AD_IMAGE_LANDSCAPE
  AD_IMAGE_SQUARE
  AD_IMAGE_VERTICAL
  STORE_LISTING
  VIDEO_MAIN
  VIDEO_SQUARE
  CAMPAIGN_LAUNCH
}

enum TaskStatus {
  LOCKED
  TODO
  SUBMITTED
  REVISION
  APPROVED
  CANCELLED
}

enum ReviewDecision {
  APPROVED
  REVISION
}

enum AssetKind {
  IMAGE
  LINK
}

enum Reaction {
  LIKED
  DISLIKED
}

enum FollowUpKind {
  DIFFERENT_ANGLE
  DIFFERENT_SIZE
  OTHER
}

enum KillReason {
  LOW_MARGIN
  SUPPLIER_ISSUE
  WEAK_CREATIVE
  POOR_AD_PERFORMANCE
  NOT_APPROVED
  OTHER
}

enum EventType {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  RESEARCH_SUBMITTED
  STAGE_CHANGED
  TASK_CREATED
  TASK_UNLOCKED
  TASK_SUBMITTED
  TASK_APPROVED
  TASK_REVISION_REQUESTED
  TASK_REASSIGNED
  TASK_CANCELLED
  TASK_REOPENED
  TASK_RELOCKED
  BRIEF_UPDATED
  BATCH_REQUESTED
  CAMPAIGN_LAUNCHED
  CAMPAIGN_STATUS_CHANGED
  PRODUCT_SENT_BACK
  PRODUCT_KILLED
  PRODUCT_COMPLETED
  OVERRIDE
  COMMENT_ADDED
  ASSET_REACTED
  ASSET_COMMENTED
  FOLLOW_UP_REQUESTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  FOLDER_UPDATED
  TASK_WITHDRAWN
  MOVED_TO_ORDERING
  ORDER_CREATED
  ORDER_UPDATED
  SCALING_UPDATED
}

/// Each phase of a product has its own discussion (comments from Product review stay there).
enum DiscussionPhase {
  REVIEW
  IMAGES
  VIDEOS
  ADS
  ORDERS
}

/// Is the product worth scaling?
enum ScaleVerdict {
  YES
  NO
  NOT_SURE
}

enum ScalePlan {
  SCALE_ADS
  INCREASE_ORDERS
  INVEST_MORE
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_REASSIGNED
  REVIEW_REQUESTED
  TASK_APPROVED
  REVISION_REQUESTED
  BRIEF_UPDATED
  MENTIONED
  SENT_BACK
  PRODUCT_KILLED
  TASK_UNASSIGNED
  FEEDBACK
  APPROVAL_REQUESTED
}

model User {
  id                String    @id @default(cuid())
  name              String
  role              Role
  pinHash           String
  avatarColor       String
  /// Uploaded profile photo (stored in Asset).
  avatarAssetId     String?
  /// Full admin permissions on top of their job role (e.g. a researcher who is also an admin).
  adminAccess       Boolean   @default(false)
  /// The Master Admin: the only one who manages the team (people, names, roles, PINs).
  isMaster          Boolean   @default(false)
  /// Individual permissions (capability keys), ticked by the Master Admin. Defaults come from the job role.
  permissions       String[]  @default([])
  /// Telegram chat this person connected (via the bot's /start link). Null = not connected.
  telegramChatId    String?   @unique
  /// One-time code in the "Connect Telegram" link; expires after 15 minutes.
  telegramLinkCode  String?   @unique
  telegramLinkUntil DateTime?
  /// Send each notification to their phone/Telegram as it happens.
  alertsInstant     Boolean   @default(true)
  /// The 10:00 (Dhaka) morning summary of what's waiting on them.
  alertsDigest      Boolean   @default(true)
  active            Boolean   @default(true)
  /// Forces a PIN change on next login (seeded users, admin PIN resets).
  mustChangePin     Boolean   @default(false)
  /// Embedded in the session cookie; bumping it revokes every session.
  sessionVersion    Int       @default(0)
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?
  /// Tie-breaker for auto-assignment (least recently assigned wins).
  lastAssignedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdProducts Product[]        @relation("ProductCreator")
  ownedProducts   Product[]        @relation("ProductMediaBuyer")
  tasks           Task[]           @relation("TaskAssignee")
  submissions     TaskSubmission[] @relation("Submitter")
  decisions       TaskSubmission[] @relation("Decider")
  comments        Comment[]
  mentions        CommentMention[]
  notifications   Notification[]   @relation("NotifRecipient")
  events          ActivityEvent[]
  avatarAsset     Asset?           @relation("UserAvatar", fields: [avatarAssetId], references: [id])
  assetComments   AssetComment[]
  orders          ProductOrder[]   @relation("OrderCreator")
  pushDevices     PushDevice[]

  @@index([role, active])
}

model Product {
  id                     String        @id @default(cuid())
  /// Human reference, shown as PRD-0042.
  number                 Int           @unique @default(autoincrement())
  name                   String
  /// Research fields are nullable so a draft can be saved; the submit gate enforces them.
  supplierUrl            String?
  imageUrl               String?
  /// All prices are entered in BDT (owner's rule). Older RMB values were converted with each product's rate.
  chinaPriceBdt          Decimal?      @db.Decimal(12, 2)
  shippingPerUnitBdt     Decimal?      @db.Decimal(12, 2)
  sellingPriceBdt        Decimal?      @db.Decimal(12, 2)
  /// Snapshot; refreshed while in RESEARCH, frozen at submit.
  rmbToBdtRate           Decimal       @db.Decimal(10, 4)
  /// Snapshot; refreshed while in RESEARCH, frozen at submit.
  courierChargePct       Decimal       @db.Decimal(5, 2)
  targetCustomer         String?
  problemSolved          String?
  sellingAngle           String?
  referenceLinks         String[]      @default([])
  priority               Priority      @default(MEDIUM)
  targetLaunchDate       DateTime?     @db.Date
  stage                  ProductStage  @default(RESEARCH)
  stageEnteredAt         DateTime      @default(now())
  /// Markdown.
  creativeBrief          String?
  creativeBriefUpdatedAt DateTime?
  killReason             KillReason?
  killNote               String?
  killedAt               DateTime?
  /// Stage the product was in when killed (for the stepper).
  stageBeforeKill        ProductStage?
  completedAt            DateTime?
  createdById            String
  /// Owning media buyer: writes the brief, reviews, launches.
  mediaBuyerId           String?
  brandId                String?
  /// The product's page on our website, once the image designer has added it there.
  websiteUrl             String?
  /// Set when the media buyer moves a well-performing live product to ordering.
  orderingSince          DateTime?
  scalable               ScaleVerdict?
  scalePlans             ScalePlan[]   @default([])
  scaleNote              String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  orders        ProductOrder[]
  createdBy     User              @relation("ProductCreator", fields: [createdById], references: [id])
  mediaBuyer    User?             @relation("ProductMediaBuyer", fields: [mediaBuyerId], references: [id])
  brand         Brand?            @relation(fields: [brandId], references: [id])
  batches       CreativeBatch[]
  tasks         Task[]
  campaign      Campaign?
  comments      Comment[]
  events        ActivityEvent[]
  transitions   StageTransition[]
  notifications Notification[]

  @@index([stage, priority])
  @@index([createdAt])
}

model CreativeBatch {
  id             String    @id @default(cuid())
  productId      String
  number         Int
  /// Short name given when the batch is requested (e.g. "Eid offer angles"). Null for the first batch.
  name           String?
  reason         String?
  /// The creative brief as it was when this batch was requested.
  briefSnapshot  String?
  /// Batch-level due date (Batch #N). Null = per-task SLA.
  dueAt          DateTime?
  /// One Google Drive folder per lane for the whole batch (no re-pasting links per task).
  imageFolderUrl String?
  videoFolderUrl String?
  requestedById  String
  createdAt      DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([productId, number])
}

model Task {
  id           String        @id @default(cuid())
  productId    String
  batchId      String?
  type         TaskType
  role         Role
  phase        Int           @default(1)
  status       TaskStatus    @default(TODO)
  /// Explicit unlock dependency (a Phase 2 task points at its Phase 1 task).
  dependsOnId  String?
  assigneeId   String?
  assignedAt   DateTime?
  unlockedAt   DateTime?
  /// Calculated from the SLA when the task unlocks.
  dueAt        DateTime?
  /// Latest revision / send-back note (shown as a banner).
  revisionNote String?
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedById String?
  /// Follow-up asked for when the original was approved (different angle / size).
  followUpOfId String?
  requestKind  FollowUpKind?
  requestNote  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  followUpOf    Task?            @relation("TaskFollowUps", fields: [followUpOfId], references: [id])
  followUps     Task[]           @relation("TaskFollowUps")
  batch         CreativeBatch?   @relation(fields: [batchId], references: [id])
  dependsOn     Task?            @relation("TaskDeps", fields: [dependsOnId], references: [id])
  dependents    Task[]           @relation("TaskDeps")
  assignee      User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  checklist     ChecklistItem[]
  submissions   TaskSubmission[]
  events        ActivityEvent[]
  notifications Notification[]
  comments      Comment[]

  @@index([assigneeId, status])
  @@index([productId, batchId])
  @@index([status, dueAt])
}

model TaskSubmission {
  id            String          @id @default(cuid())
  taskId        String
  version       Int
  /// Legacy single link (now stored as a LINK item in `items`).
  url           String?
  note          String?
  submittedById String
  decision      ReviewDecision?
  decisionNote  String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime        @default(now())

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy User             @relation("Submitter", fields: [submittedById], references: [id])
  decidedBy   User?            @relation("Decider", fields: [decidedById], references: [id])
  items       SubmissionItem[]

  @@unique([taskId, version])
}

/// Binary file stored in Postgres (images are compressed in the browser first).
/// Keeps hosting portable: no object-storage service needed.
model Asset {
  id           String   @id @default(cuid())
  mime         String
  bytes        Bytes
  width        Int?
  height       Int?
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  items       SubmissionItem[]
  avatarUsers User[]           @relation("UserAvatar")
}

/// One image or link inside a submission round; reviewers react and comment per item.
model SubmissionItem {
  id           String    @id @default(cuid())
  submissionId String
  order        Int
  kind         AssetKind
  assetId      String?
  url          String?
  label        String?
  reaction     Reaction?
  reactedById  String?
  reactedAt    DateTime?
  createdAt    DateTime  @default(now())

  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  asset      Asset?         @relation(fields: [assetId], references: [id])
  comments   AssetComment[]

  @@index([submissionId, order])
}

model AssetComment {
  id        String   @id @default(cuid())
  itemId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  item   SubmissionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorId], references: [id])

  @@index([itemId, createdAt])
}

/// Per-task-type configuration: SLA and the "How we do this" step guide.
model TaskTypeConfig {
  taskType    TaskType @id
  slaHours    Int
  /// Markdown.
  guideBody   String   @default("")
  /// [{ label, url }] — validated with zod.
  guideLinks  Json     @default("[]")
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model ChecklistTemplateItem {
  id        String   @id @default(cuid())
  taskType  TaskType
  label     String
  required  Boolean  @default(true)
  order     Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([taskType, active, order])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  taskId      String
  /// Snapshot of the template label at task creation.
  label       String
  required    Boolean
  order       Int
  checked     Boolean   @default(false)
  checkedById String?
  checkedAt   DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, order])
}

model Campaign {
  id             String         @id @default(cuid())
  productId      String         @unique
  status         CampaignStatus @default(NOT_LAUNCHED)
  adsManagerUrl  String?
  metaCampaignId String?
  dailyBudgetUsd Decimal?       @db.Decimal(10, 2)
  strategyNotes  String?
  launchedAt     DateTime?
  launchedById   String?
  updatedAt      DateTime       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// One row per stage change; drives time-in-stage and bottleneck averages.
model StageTransition {
  id        String        @id @default(cuid())
  productId String
  fromStage ProductStage?
  toStage   ProductStage
  actorId   String
  at        DateTime      @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, at])
  @@index([toStage, at])
}

model Comment {
  id        String          @id @default(cuid())
  productId String
  authorId  String
  /// One level of replies (enforced in the domain layer).
  parentId  String?
  body      String
  phase     DiscussionPhase @default(REVIEW)
  /// Set when the comment belongs to one creative task (its discussion lives inside the task).
  taskId    String?
  createdAt DateTime        @default(now())
  editedAt  DateTime?

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  task     Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id])
  parent   Comment?         @relation("Replies", fields: [parentId], references: [id])
  replies  Comment[]        @relation("Replies")
  mentions CommentMention[]

  @@index([productId, phase, createdAt])
  @@index([taskId])
}

model CommentMention {
  commentId String
  userId    String

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([commentId, userId])
}

model ActivityEvent {
  id        String    @id @default(cuid())
  productId String?
  taskId    String?
  actorId   String
  type      EventType
  /// { from, to, note, fields: { name: { old, new } } } — zod-typed per EventType.
  data      Json?
  createdAt DateTime  @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor   User     @relation(fields: [actorId], references: [id])

  @@index([productId, createdAt])
  @@index([type, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  productId String?
  taskId    String?
  type      NotificationType
  message   String
  readAt    DateTime?
  /// When this was sent to the person's devices / Telegram (null = not yet, or not wanted).
  pushedAt  DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation("NotifRecipient", fields: [userId], references: [id])
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
}

/// Per-IP login throttle (complements the per-account lockout).
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

/// Single row, id = 1.
model Settings {
  id                    Int      @id @default(1)
  rmbToBdtRate          Decimal  @db.Decimal(10, 4)
  usdToBdtRate          Decimal  @db.Decimal(10, 4)
  courierChargePct      Decimal  @default(2) @db.Decimal(5, 2)
  healthyMarginPct      Decimal  @db.Decimal(5, 2)
  thinMarginPct         Decimal  @db.Decimal(5, 2)
  /// Web push keys, created automatically the first time push is used.
  vapidPublicKey        String?
  vapidPrivateKey       String?
  /// Telegram bot, connected by an Admin in Settings → Notifications.
  telegramBotToken      String?
  telegramBotUsername   String?
  telegramWebhookSecret String?
  /// Public address of the app (for links in Telegram messages).
  appUrl                String?
  /// Dhaka date (YYYY-MM-DD) of the last morning summary, so it goes out once a day.
  lastDigestOn          String?
  updatedById           String?
  updatedAt             DateTime @updatedAt
}

/// Store brands (Timtom, Mr.WOW, …). Every new product belongs to one.
model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  /// Brand colour as hex (e.g. #15803D). Product pages use it for buttons and links.
  color     String    @default("#4F46E5")
  active    Boolean   @default(true)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  products  Product[]
}

/// A stock order for a product. Prices are per unit and independent of the research prices
/// (supplier prices change between orders).
model ProductOrder {
  id               String   @id @default(cuid())
  productId        String
  /// 1, 2, 3… per product.
  number           Int
  quantity         Int
  buyingPriceBdt   Decimal  @db.Decimal(12, 2)
  shippingCostBdt  Decimal  @db.Decimal(12, 2)
  sellingPriceBdt  Decimal  @db.Decimal(12, 2)
  /// Courier % used for the profit estimate (copied from Settings when the order is created).
  courierChargePct Decimal  @db.Decimal(5, 2)
  orderedOn        DateTime @db.Date
  note             String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User    @relation("OrderCreator", fields: [createdById], references: [id])

  @@unique([productId, number])
}

/// A browser / phone that turned on push notifications for one person.
model PushDevice {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
