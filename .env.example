# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env for local development:   cp .env.example .env
# On Vercel, set these under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Pooled connection — used by the app at runtime.
# Neon: the connection string whose host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection — used by `prisma migrate` and the seed.
# Neon: the same string WITHOUT "-pooler" in the host.
# (If you use Vercel's Neon integration it sets DATABASE_URL_UNPOOLED, which is
#  also accepted, so DIRECT_URL can be left unset there.)
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Signs session cookies. At least 32 random characters. Generate one with:
#   openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET="replace-with-output-of-openssl-rand-base64-48"

# Only needed when running `npm run db:seed` (not by the running app).
# Admin (Sakib) PIN — 4–6 digits, not a repeat (1111) or a run (1234).
SEED_ADMIN_PIN="246810"
# Temporary PIN for every other seeded person; they must change it at first sign-in.
SEED_DEFAULT_PIN="1357"

# ── Optional ────────────────────────────────────────────────────────────────
# Public address of the app (links in Telegram messages; the VPS setup sets it).
# APP_URL="https://sop.example.com"
# Protects /api/cron/morning (Vercel Cron sends it automatically; the VPS setup creates one).
# CRON_SECRET="long-random-string"
# Contact for web push (defaults to the app's address).
# VAPID_SUBJECT="mailto:you@example.com"
